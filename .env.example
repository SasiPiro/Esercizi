# Copy to .env (never committed) and fill in. docker compose reads it automatically.

# HMAC key for the JWTs, at least 32 bytes. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=

# Password of the PostgreSQL user "ecommerce" (used by the db and app services)
POSTGRES_PASSWORD=

# Optional: comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=
